# Required only by the Telegram gateway runtime.
# Obtain from BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Exact POST endpoint implemented by the partner backend.
# Example: http://127.0.0.1:8000/v1/mori/respond
MORI_BACKEND_URL=

# Optional shared secret used by the gateway to authenticate to the backend.
MORI_BACKEND_API_KEY=

# Optional comma-separated Telegram chat IDs allowed during testing.
MORI_ALLOWED_CHAT_IDS=

MORI_BACKEND_TIMEOUT_SECONDS=60
MORI_LOG_LEVEL=INFO

